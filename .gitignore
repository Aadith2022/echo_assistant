# --- Secrets: never commit ---
.env
.env.*
!.env.example
*credentials*.json
token.json
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Model weights (Kokoro is 325MB, over GitHub's 100MB limit) ---
assistant/models/kokoro/

# --- Runtime state / generated data ---
assistant/memory_db/
assistant/logs/
assistant/screenshots/
*.log
*.sqlite
*.sqlite3
*.db

# --- Internal working notes, kept local ---
CLAUDE.md
CLAUDE.md.bak
# Leading slash: root only. Without it this would also match assistant/memory/,
# which is the real memory subsystem.
/memory/
# Corpus run output: machine-specific timings that go stale between sessions
assistant/baseline_*.json

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
*.swp
