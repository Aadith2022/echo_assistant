GOOGLE_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_CREDENTIALS_PATH=./google_credentials.json
GEMINI_MODEL=gemini-3.1-pro-preview
PRIVILEGED_LLM_FALLBACK=gemini-3.5-flash

# --- Voice (Phase 4) ---
# All optional: voice is off unless you pass --voice or set VOICE_ENABLED=true.
VOICE_ENABLED=false
VOICE_ACTIVATION=hotkey            # hotkey | wakeword
VOICE_HOTKEY=<ctrl>+<space>
VOICE_WAKE_WORD=hey_jarvis          # pretrained openWakeWord model name; no "Echo" model exists yet
VOICE_WAKE_THRESHOLD=0.5
VOICE_STT_MODEL=small.en
VOICE_STT_DEVICE=auto              # auto | cuda | cpu
VOICE_SILENCE_MS=600
VOICE_MAX_UTTERANCE_SEC=30
VOICE_MODEL=                       # optional faster model for spoken turns

# Mic stays armed while speaking so you can interrupt by voice; EchoGuard
# rejects the assistant's own audio. Set false to hard-gate the mic instead.
VOICE_MIC_DURING_PLAYBACK=true
VOICE_ECHO_THRESHOLD=0.6
VOICE_TYPING_BARGE_IN=true
VOICE_SPEAK_TEXT_REPLIES=false
# Gemini holds the stream open ~2.4s past the final token; this speaks a
# trailing fragment once no token has arrived for this long. Worst measured
# gap between real tokens is 108ms, so 500ms cannot split live output.
VOICE_TTS_IDLE_FLUSH_MS=500
# Short tone when activation registers and when it gives up waiting for you to
# start talking. How long it waits for you to start speaking before giving up:
VOICE_CUES_ENABLED=true
VOICE_LISTEN_TIMEOUT_SEC=4.0

# Kokoro is local and needs no account. ElevenLabs is an optional upgrade.
TTS_BACKEND=kokoro                 # kokoro | elevenlabs
KOKORO_MODEL_DIR=./models/kokoro
KOKORO_VOICE=af_heart
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Screen context (Phase 5) ---
VISION_MODEL=gemini-3.5-flash      # Tier 2 (screenshot) vision model
OVERLAY_ENABLED=true               # PyQt6 toast/highlight overlay; false for headless boxes
ACCESSIBILITY_MAX_DEPTH=6          # Tier 1 element-tree walk depth
ACCESSIBILITY_MAX_ELEMENTS=150     # Tier 1 element-tree size cap

# --- Browser automation (Phase 6) ---
# Gate 0: try to answer without launching a browser at all.
NO_BROWSER_GATE_ENABLED=true
NO_BROWSER_TIMEOUT_SECONDS=15
# Jina Reader renders pages server-side - useful, but it means sending the URL
# to a third party. Set false to keep every fetch first-party.
JINA_READER_ENABLED=true
JINA_READER_ENDPOINT=https://r.jina.ai/
MAX_EXTRACTED_CHARS=12000

# Patchright stealth needs a persistent profile, real Chrome, and a visible
# window - headless and custom user agents are what make automation detectable.
# The default profile is dedicated and logged out: an injected page that
# hijacks the agent has no sessions to abuse. Point BROWSER_USER_DATA_DIR at
# your real Chrome profile only once you trust the guardrails (and note Chrome
# locks a profile while it is open).
BROWSER_USER_DATA_DIR=./browser_profile
BROWSER_CHANNEL=chrome             # chrome | chromium
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_SECONDS=30
BROWSER_IDLE_SHUTDOWN_SECONDS=300
BROWSER_MIN_ACTION_DELAY=0.25
BROWSER_MAX_ACTION_DELAY=0.9

# Empty = local browser. Set to http://localhost:3000 to route through a
# self-hosted Steel Browser for Cloudflare/DataDome/PerimeterX sites.
STEEL_BROWSER_ENDPOINT=
RESIDENTIAL_PROXY_URL=

# Dual-LLM: the Quarantined model sees all untrusted page content, has no
# tools, and can only return schema-validated JSON.
QUARANTINED_MODEL=gemini-3.5-flash
PROMPT_INJECTION_SCAN=true

# Planner/Actor/Validator loop.
PLANNER_MODEL=                     # empty = GEMINI_MODEL
ACTOR_MODEL=gemini-3.5-flash
VALIDATOR_MODEL=gemini-3.5-flash
BROWSER_MAX_STEPS=15
BROWSER_MAX_RETRIES_PER_STEP=2

ACTION_CACHE_ENABLED=true
ACTION_CACHE_TTL_DAYS=7

# Typed confirmation for irreversible actions (purchases, deletions, sending).
CONFIRM_HIGH_RISK=true
# Optional: reputation check on URLs found in extracted content.
SAFE_BROWSING_API_KEY=
