GOOGLE_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
GOOGLE_CREDENTIALS_PATH=./google_credentials.json
GEMINI_MODEL=gemini-3.1-pro-preview
PRIVILEGED_LLM_FALLBACK=gemini-3.5-flash
# Hard ceiling on any single Gemini call. Without it a stalled request retries
# inside the SDK indefinitely, which is indistinguishable from a hang.
GEMINI_TIMEOUT_SECONDS=30

# --- User Alignment Critic ---
# Reviews proposed actions against your original request and can veto them.
# Sees only your intent and one action - never the conversation or page content.
CRITIC_ENABLED=true
# A bounded yes/no judgement, so it runs on the cheapest tier.
CRITIC_MODEL=gemini-3.1-flash-lite
# "gemini" (cloud) or "ollama" (local, for private mode). Ollama falls back to
# Gemini if unreachable. Small local models are miscalibrated in both
# directions, so treat the local backend as experimental.
CRITIC_BACKEND=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CRITIC_MODEL=gemma3:4b

# --- Memory ---
# sentence-transformers model used to embed stored facts. Changing it after
# facts exist makes old embeddings incomparable - clear memory_db/ if you do.
MEMORY_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Voice ---
# All optional: voice is off unless you pass --voice or set VOICE_ENABLED=true.
VOICE_ENABLED=false
VOICE_ACTIVATION=hotkey            # hotkey | wakeword
VOICE_HOTKEY=<ctrl>+<space>
VOICE_WAKE_WORD=hey_jarvis          # pretrained openWakeWord model name; no "Echo" model exists yet
VOICE_WAKE_THRESHOLD=0.5
VOICE_STT_MODEL=small.en
VOICE_STT_DEVICE=auto              # auto | cuda | cpu
VOICE_SILENCE_MS=600
VOICE_MAX_UTTERANCE_SEC=30
VOICE_MODEL=                       # optional faster model for spoken turns

# Mic stays armed while speaking so you can interrupt by voice; EchoGuard
# rejects the assistant's own audio. Set false to hard-gate the mic instead.
VOICE_MIC_DURING_PLAYBACK=true
VOICE_ECHO_THRESHOLD=0.6
VOICE_TYPING_BARGE_IN=true
VOICE_SPEAK_TEXT_REPLIES=false
# Gemini holds the stream open ~2.4s past the final token; this speaks a
# trailing fragment once no token has arrived for this long. Worst measured
# gap between real tokens is 108ms, so 500ms cannot split live output.
VOICE_TTS_IDLE_FLUSH_MS=500
# Short tone when activation registers and when it gives up waiting for you to
# start talking. How long it waits for you to start speaking before giving up:
VOICE_CUES_ENABLED=true
VOICE_LISTEN_TIMEOUT_SEC=8.0

# Kokoro is local and needs no account. ElevenLabs is an optional upgrade.
TTS_BACKEND=kokoro                 # kokoro | elevenlabs
KOKORO_MODEL_DIR=./models/kokoro
KOKORO_VOICE=af_heart
# onnxruntime intra-op threads. The default (all cores) is slower than a small
# cap on high-core machines, and capping leaves headroom for the STT model.
KOKORO_THREADS=4
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Screen context ---
VISION_MODEL=gemini-3.5-flash      # Tier 2 (screenshot) vision model
OVERLAY_ENABLED=true               # PyQt6 toast/highlight overlay; false for headless boxes
ACCESSIBILITY_MAX_DEPTH=6          # Tier 1 element-tree walk depth
ACCESSIBILITY_MAX_ELEMENTS=150     # Tier 1 element-tree size cap

# --- Browser automation ---
# Gate 0: try to answer without launching a browser at all.
NO_BROWSER_GATE_ENABLED=true
NO_BROWSER_TIMEOUT_SECONDS=15
# Jina Reader renders pages server-side - useful, but it means sending the URL
# to a third party. Set false to keep every fetch first-party.
JINA_READER_ENABLED=true
JINA_READER_ENDPOINT=https://r.jina.ai/
MAX_EXTRACTED_CHARS=12000

# Patchright stealth needs a persistent profile, real Chrome, and a visible
# window - headless and custom user agents are what make automation detectable.
# The default profile is dedicated and logged out: an injected page that
# hijacks the agent has no sessions to abuse. Point BROWSER_USER_DATA_DIR at
# your real Chrome profile only once you trust the guardrails (and note Chrome
# locks a profile while it is open).
BROWSER_USER_DATA_DIR=./browser_profile
BROWSER_CHANNEL=chrome             # chrome | chromium
BROWSER_HEADLESS=false
# Not cosmetic. no_viewport=true makes the viewport follow the window, and
# Chrome's ~800x600 default triggers responsive sites' compact layouts -
# Wikipedia hides its search input entirely at that width.
BROWSER_WINDOW_SIZE=1920,1080
BROWSER_TIMEOUT_SECONDS=30
# Per-element budget, separate from navigation above: short, so that picking an
# element that can't be interacted with costs seconds rather than half a minute.
BROWSER_ACTION_TIMEOUT_SECONDS=8
# Wait for network-idle before reading a page.
BROWSER_SETTLE_MS=4000

BROWSER_CLEAR_SITE_DATA=false
BROWSER_IDLE_SHUTDOWN_SECONDS=300
BROWSER_MIN_ACTION_DELAY=0.25
BROWSER_MAX_ACTION_DELAY=0.9

# Empty = local browser. Set to http://localhost:3000 to route through a
# self-hosted Steel Browser for Cloudflare/DataDome/PerimeterX sites.
STEEL_BROWSER_ENDPOINT=
RESIDENTIAL_PROXY_URL=

# Dual-LLM: the Quarantined model sees all untrusted page content, has no
# tools, and can only return schema-validated JSON.
QUARANTINED_MODEL=gemini-3.5-flash
PROMPT_INJECTION_SCAN=true
# The browser roles send a whole page state rather than a chat turn, which on a
# dense page is large enough to push a single call past GEMINI_TIMEOUT_SECONDS.
BROWSER_MODEL_TIMEOUT_SECONDS=90

# Planner/Actor/Validator loop.
PLANNER_MODEL=                     # empty = GEMINI_MODEL
ACTOR_MODEL=gemini-3.5-flash
VALIDATOR_MODEL=gemini-3.5-flash
BROWSER_MAX_STEPS=15
BROWSER_MAX_RETRIES_PER_STEP=2
BROWSER_MAX_ITERATIONS_PER_STEP=20     # RUNAWAY GUARD on observe->act rounds, not the usual limit.
                                       # A ceiling, not a quota - a 3-round step still costs 3.
BROWSER_MAX_STALLS_PER_STEP=4          # consecutive no-effect rounds before abandoning a step.
                                       # THIS is what normally ends a step: work while the page responds
BROWSER_MAX_VETOES_PER_STEP=3          # Critic refusals tolerated; they do NOT spend the iteration
                                       # budget, or the safety layer starves the step it supervises
# Times a task may revise its remaining steps after one misses its goal. The
# Planner writes the whole plan before seeing a page, so on a long task reality
# diverges from it. Bounded, because each re-plan is also the one point where
# page content reaches the Planner.
BROWSER_MAX_REPLANS_PER_TASK=2

# Facts one browser task established, carried to the next task in the session.
# Without it every task is an island: ask for flights then hotels, and the hotel
# search has no idea which dates the flight landed on. Session-scoped, so it
# holds "the trip I am planning now", not a fare that was true last week.
# Facts are stripped of URLs/hostnames before the Planner sees them, so a page
# cannot nominate a domain for a later task's Origin Set.
BROWSER_LEDGER_ENABLED=true

# Independent steps pinned to DIFFERENT sites run at the same time, one tab each.
# Overlaps model latency (~82% of a step); page operations stay serialised on the
# browser thread. Measured 2.0x on three branches with a conservative 4s/branch
# model stand-in. A branch is scoped to only its own site - stricter than the
# task-wide Origin Set it would inherit running in sequence.
BROWSER_PARALLEL_ENABLED=true
BROWSER_MAX_PARALLEL_BRANCHES=3        # each branch is a real tab plus its own model calls

ACTION_CACHE_ENABLED=true
ACTION_CACHE_TTL_DAYS=7

# Typed confirmation for irreversible actions (purchases, deletions, sending).
CONFIRM_HIGH_RISK=true
# Optional: reputation check on URLs found in extracted content.
SAFE_BROWSING_API_KEY=
